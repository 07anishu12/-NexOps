# ==============================================================================
# AgentFlow OS — Environment Configuration Template
# All secret references must resolve only in server processes. Never commit .env
# ==============================================================================

# Core Application
NODE_ENV=development
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
WIDGET_CDN_URL=http://localhost:3002
SESSION_SECRET=dev-insecure-session-secret-change-in-production-min-32-chars
ENCRYPTION_KEY_REFERENCE=dev-encryption-key-00000000000000000000000000000000
DATABASE_URL=postgresql://agentflow:agentflow_secret@localhost:5432/agentflow_dev
REDIS_URL=redis://localhost:6379

# Object Storage
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=agentflow-assets
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin

# Authentication / OAuth
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
OAUTH_STATE_SIGNING_KEY_REFERENCE=dev-oauth-state-signing-key-min-32-chars

# Model Providers
DEFAULT_MODEL_PROVIDER=openai
MODEL_PROVIDER_KEY_REFERENCE=sk-mock-key-for-local-testing

# Meta / Instagram Integration
META_APP_ID=mock-meta-app-id
META_APP_SECRET=mock-meta-app-secret
META_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/instagram/callback
META_WEBHOOK_VERIFY_TOKEN=mock-meta-verify-token
META_API_VERSION=v19.0

# Razorpay Payments
RAZORPAY_KEY_ID=rzp_test_mockkeyid123
RAZORPAY_KEY_SECRET=rzp_test_mocksecret123
RAZORPAY_WEBHOOK_SECRET_REFERENCE=mock_razorpay_webhook_secret

# Queue / Worker Configuration
WORKER_CONCURRENCY=5
RUN_QUEUE_NAME=agentflow-run-queue
WEBHOOK_QUEUE_NAME=agentflow-webhook-queue
SCHEDULER_QUEUE_NAME=agentflow-scheduler-queue
JOB_LOCK_DURATION_MS=30000

# Observability
OTEL_SERVICE_NAME=agentflow-monorepo
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS_REFERENCE=
LOG_LEVEL=info
ERROR_REPORTING_DSN_REFERENCE=

# Security & Quota Limits
PUBLIC_WIDGET_SESSION_TTL_SECONDS=3600
DEFAULT_RUN_TIMEOUT_SECONDS=120
MAX_ATTACHMENT_BYTES=10485760
DEFAULT_PUBLIC_RATE_LIMIT=60
ALLOWED_UPLOAD_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf,text/plain,text/csv
