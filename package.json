{
  "name": "agentflow-os",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant agentic AI platform, workflow runtime and forward deployed engineering control plane",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && pnpm test:infrastructure",
    "test:architecture": "vitest run tests/architecture",
    "test:infrastructure": "vitest run tests/infrastructure",
    "dev:setup": "node scripts/dev-setup.mjs",
    "infra:up": "node scripts/infra.mjs up",
    "infra:down": "node scripts/infra.mjs down",
    "infra:status": "node scripts/infra.mjs status",
    "infra:logs": "node scripts/infra.mjs logs",
    "infra:wait": "node scripts/infra.mjs wait",
    "dev:reset": "node scripts/dev-reset.mjs",
    "db:generate": "pnpm --filter @agentflow/database db:generate",
    "db:migrate": "pnpm --filter @agentflow/database db:migrate",
    "db:status": "pnpm --filter @agentflow/database db:status",
    "db:check": "pnpm --filter @agentflow/database db:check",
    "db:seed": "pnpm --filter @agentflow/database db:seed",
    "db:rollback": "pnpm --filter @agentflow/database db:rollback",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "eslint": "^9.20.1",
    "prettier": "^3.5.1",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.0.5"
  }
}
